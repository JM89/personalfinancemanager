{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Keep React and its renderer on matching versions.",
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "React"
    },
    {
      "description": "Update Docusaurus packages together.",
      "matchPackageNames": ["@docusaurus/*"],
      "groupName": "Docusaurus"
    }
  ]
}
