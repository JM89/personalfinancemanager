<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1819c351-5b5c-4b8e-80f9-8b219b7a4d95</UserSecretsId>
    <SpaRoot>../PFM.Website.Client/</SpaRoot>
    <SpaProxyWorkingDirectory>$(SpaRoot)</SpaProxyWorkingDirectory>
    <SpaProxyServerUrl>http://localhost:5174</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev -- --host 127.0.0.1 --port 5174</SpaProxyLaunchCommand>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="11.0.0" />
    <ProjectReference Include="../PFM.Services/PFM.Services.csproj" />
  </ItemGroup>
  <Target Name="PublishReact" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(SpaRoot)dist/index.html')" Text="Build the React app before publishing: run npm ci and npm run build in PFM.Website.Client." />
    <ItemGroup>
      <ReactDist Include="$(SpaRoot)dist/**/*" />
      <ResolvedFileToPublish Include="@(ReactDist->'%(FullPath)')">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
